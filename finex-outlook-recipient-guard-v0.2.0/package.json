{
  "name": "finex-outlook-recipient-guard",
  "version": "0.2.0",
  "private": true,
  "description": "Outlook Smart Alerts add-in that validates recipients and attachment size before send.",
  "scripts": {
    "icons": "node scripts/generate-icons.js",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "manifest:production": "node scripts/prepare-production-manifest.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:manifest": "office-addin-manifest validate manifest.xml",
    "validate:manifest:production": "office-addin-manifest validate manifest.production.xml"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.604",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5.6.4",
    "office-addin-manifest": "^1.13.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0"
  },
  "allowScripts": {
    "xml2js@0.4.23": true,
    "esbuild@0.28.1": true
  }
}
